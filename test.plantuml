@startuml
entity "Drugs" as Drugs {
    + id : int <<PK>>
    --
    name : varchar
    manufacturer_id : int <<FK>>
    price : decimal
    quantity : int
    provider_id : int
    cost : decimal
    is_allowed : varchar
    last_updated : date
    checked_by_user : tinyint
    who_checked : int
    is_hidden : tinyint
    medicinePhoto : text
}

entity "Orders" as Orders {
    + id : int <<PK>>
    --
    user_id : int <<FK>>
    provider_id : int
    manufacturer_id : int <<FK>>
    drug_id : int <<FK>>
    quantity : int
    price : decimal
    cost : decimal
    status : varchar
    last_updated : date
    checked_by_user : tinyint
    is_hidden_byShopper : tinyint
    is_hidden_byProvider : tinyint
}

entity "Users" as Users {
    + id : int <<PK>>
    --
    name : varchar
    password : varchar
    type : int
    profilePhoto : longblob
}

entity "Manufacturers" as Manufacturers {
    + id : int <<PK>>
    --
    name : varchar
}

entity "MedicineWeights" as MedicineWeights {
    + id : int <<PK>>
    --
    user_id : int <<FK>>
    last_updated : date
    C_quantity_in_orders : decimal
    C_frequency_of_use : decimal
    C_availability_in_stock : decimal
    C_comparative_price : decimal
    C_demand_for_medicine : decimal
    C_manufacturer : decimal
}

entity "SysActivityLog" as SysActivityLog {
    + id : int <<PK>>
    --
    actor_id : int <<FK>>
    action_datetime : datetime
    action : text
}

' Исправленные связи между таблицами
Drugs }o--|| Manufacturers : "manufacturer_id → id"
Drugs }o--|| Orders : "id → drug_id"
Users ||--o{ Orders : "id → user_id"
Users ||--|| MedicineWeights : "id → user_id"
SysActivityLog ||--|| Users : "actor_id → id"
@enduml